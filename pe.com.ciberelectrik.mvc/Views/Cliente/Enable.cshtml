@model pe.com.ciberelectrik.mvc.Models.Cliente

@{
    ViewBag.Title = "Habilitar Cliente";
}

<h2 class="text-center">Habilitar Cliente</h2>

<h4>¿Estás seguro que deseas habilitar este cliente?</h4>

<div>
    <dl class="dl-horizontal">
        <dt>Código</dt>
        <dd>@Model.codigo</dd>

        <dt>Nombre</dt>
        <dd>@(Model.nombre + " " + Model.apellidopaterno + " " + Model.apellidomaterno)</dd>

        <dt>Documento</dt>
        <dd>@Model.numerodocumento</dd>

        <dt>Correo</dt>
        <dd>@Model.correo</dd>
    </dl>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-success">Habilitar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
}
