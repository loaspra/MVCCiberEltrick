@model IEnumerable<pe.com.ciberelectrik.mvc.Models.Cliente>

@{
    ViewBag.Title = "Clientes";
}

<h2 class="text-center">Listado de Clientes</h2>

<p>
    @Html.ActionLink("Nuevo Cliente", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre Completo</th>
            <th>Documento</th>
            <th>Correo</th>
            <th>Distrito</th>
            <th>Sexo</th>
            <th>Estado</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.codigo</td>
                <td>@(c.nombre + " " + c.apellidopaterno + " " + c.apellidomaterno)</td>
                <td>@c.numerodocumento</td>
                <td>@c.correo</td>
                <td>@c.distrito.nomdis</td>
                <td>@c.sexo.nomsex</td>

                <td>
                    @if (c.estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>

                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = c.codigo }, new { @class = "btn btn-warning btn-sm" })

                    @if (c.estado)
                    {
                        @Html.ActionLink("Eliminar", "Delete", new { id = c.codigo },
                            new { @class = "btn btn-danger btn-sm", onclick = "return confirm('¿Eliminar cliente?')" })
                    }
                    else
                    {
                        @Html.ActionLink("Habilitar", "Enable", new { id = c.codigo },
                            new { @class = "btn btn-success btn-sm", onclick = "return confirm('¿Habilitar cliente?')" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
